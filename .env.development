VITE_API_BASE_URL=http://localhost:8081
# The STOMP endpoint /ws is registered on the main server, so this is the same
# port as the API — 8081 in dev. It pointed at 8082 (the stage port), so the
# interview socket dialled a port with nothing behind it: the candidate got
# "Connection lost. Reconnecting..." and no first question ever arrived.
VITE_WS_URL=ws://localhost:8081
VITE_WS_BASE_URL=ws://localhost:8081
VITE_LOCAL_IP=192.168.1.8

# ── Coding exam (optional; defaults in src/config/coding-exam.config.ts) ──
# Which test cases show their input and expected output during the exam:
#   locked  = nothing shown until that case passes (default)
#   open    = every case shows input, expected and the candidate's output
#   partial = the first few are open, the rest unlock as they pass ("half" also works)
VITE_CODING_TESTCASE_VISIBILITY=partial
# partial only: fixed number of open cases. 0 = work it out from the ratio below.
VITE_CODING_TESTCASE_OPEN_COUNT=0
# partial only: fraction open from the start, rounded down. 0.5 = half.
VITE_CODING_TESTCASE_OPEN_RATIO=0.5

# ── Exam proctoring (optional; defaults in src/config/proctoring.config.ts) ──
VITE_PROCTORING_CAMERA_REQUIRED=false
VITE_PROCTORING_FULLSCREEN_ENABLED=true
VITE_PROCTORING_TAB_SWITCH_ENABLED=true
# Auto-submit after this many tab switches (0 = warn only).
VITE_PROCTORING_MAX_TAB_SWITCHES=5
VITE_PROCTORING_EYE_DETECTION_ENABLED=true
# Auto-submit after this many face warnings (0 = warn only).
VITE_PROCTORING_MAX_EYE_WARNINGS=5
# How often the face check runs, in ms.
VITE_PROCTORING_EYE_CHECK_INTERVAL_MS=4000

# ── Noise check ──
VITE_PROCTORING_NOISE_ENABLED=true
# dBFS: below WARN is green, WARN to BLOCK is amber, above BLOCK is red.
VITE_PROCTORING_NOISE_WARN_DB=-45
VITE_PROCTORING_NOISE_BLOCK_DB=-32
# How long it must stay loud before turning red, in ms.
VITE_PROCTORING_NOISE_SUSTAIN_MS=1500
# false = red warns but never blocks the start.
VITE_PROCTORING_NOISE_BLOCKS_START=true

# ── Identity photo ──
# true = required; false = step hidden.
VITE_PROCTORING_PHOTO_REQUIRED=true
# Longest edge of the saved image, in px.
VITE_PROCTORING_PHOTO_MAX_WIDTH=640

# ── Room scan ──
# true = required 360° sweep; false = step hidden.
VITE_PROCTORING_ROOM_SCAN_REQUIRED=true
VITE_PROCTORING_ROOM_SCAN_FRAMES=8
# Time given for the full turn, in ms.
VITE_PROCTORING_ROOM_SCAN_DURATION_MS=16000
# ── Phone as a second camera (interviews) ──
# true = the candidate must pair their phone before starting;
# false = the QR is offered and they may begin without it.
VITE_PROCTORING_MOBILE_REQUIRED=false

# -- Interview recording --
# Each stream is either asked for or skipped outright; there is no "optional".
# true  = recorded and uploaded with the interview.
# false = skipped entirely, and the candidate is never prompted for it.
# The candidate's camera and microphone. False still leaves the camera free to
# open for face detection (VITE_PROCTORING_EYE_DETECTION_ENABLED) -- it only
# stops the recording being made and uploaded.
VITE_PROCTORING_CAMERA_RECORDING_REQUIRED=true
# The candidate's screen, via the browser's display-capture prompt.
VITE_PROCTORING_SCREEN_RECORDING_REQUIRED=true
