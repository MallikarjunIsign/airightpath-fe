<td>Job CRUD</td>
</tr>
<tr>
<td><code>job-application.service.ts</code></td>
<td>Apply, list, screen, shortlist, referral status, all candidate mails</td>
</tr>
<tr>
<td><code>resume.service.ts</code></td>
<td>Upload/update/view resume, bulk upload</td>
</tr>
<tr>
<td><code>ats.service.ts</code></td>
<td>Batch resume screening</td>
</tr>
<tr>
<td><code>assessment.service.ts</code></td>
<td>Upload paper, assign, fetch, submit, save result, reschedule, question generation</td>
</tr>
