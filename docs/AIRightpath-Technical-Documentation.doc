</tr>
<tr>
<td><code>auth.service.ts</code></td>
<td>Login, register, refresh, logout, <code>/me</code>, OTP, passwords</td>
</tr>
<tr>
<td><code>user.service.ts</code></td>
<td>User list, profile, activate/deactivate, avatar</td>
</tr>
