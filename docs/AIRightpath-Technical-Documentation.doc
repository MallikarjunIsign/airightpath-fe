</tr>
<tr>
<td><code>datetime.utils.ts</code> · <code>format.utils.ts</code></td>
<td><code>parseStamp</code> and display formatting for the mixed timestamp shapes the API returns</td>
</tr>
</tbody></table>
<h2>Configuration files</h2>
<table border="1" cellspacing="0" cellpadding="6">
<thead>
<tr>
<th>File</th>
<th>Contents</th>
</tr>
</thead>
<tbody><tr>
<td><code>env.ts</code></td>
