# VITE_API_BASE_URL=https://api.airightpath.com
# VITE_WS_URL=wss://api.airightpath.com
# VITE_WS_BASE_URL=wss://api.airightpath.com

VITE_API_BASE_URL=https://devapi.airightpath.com
VITE_WS_URL=wss://devapi.airightpath.com
VITE_WS_BASE_URL=wss://devapi.airightpath.com

# ── Exam proctoring (all optional; defaults in src/config/proctoring.config.ts) ──
# Camera required to take the exam (blocks with a retry overlay until enabled).
VITE_PROCTORING_CAMERA_REQUIRED=true
# Require fullscreen during the exam.
VITE_PROCTORING_FULLSCREEN_ENABLED=true
# Tab-switch monitoring. MAX = auto-submit after N switches (0 = warn only).
VITE_PROCTORING_TAB_SWITCH_ENABLED=true
VITE_PROCTORING_MAX_TAB_SWITCHES=5
# Face/eye detection. MAX = auto-submit after N warnings (0 = warn only).
VITE_PROCTORING_EYE_DETECTION_ENABLED=true
VITE_PROCTORING_MAX_EYE_WARNINGS=5
