# VITE_API_BASE_URL=https://api.airightpath.com
# VITE_WS_URL=wss://api.airightpath.com
# VITE_WS_BASE_URL=wss://api.airightpath.com

VITE_API_BASE_URL=https://devapi.airightpath.com
VITE_WS_URL=wss://devapi.airightpath.com
VITE_WS_BASE_URL=wss://devapi.airightpath.com

# ── Exam proctoring (optional; defaults in src/config/proctoring.config.ts) ──
VITE_PROCTORING_CAMERA_REQUIRED=true
VITE_PROCTORING_FULLSCREEN_ENABLED=true
VITE_PROCTORING_TAB_SWITCH_ENABLED=true
# Auto-submit after this many tab switches (0 = warn only).
# 1 = strict: the first tab switch ends the exam immediately, with no warning.
VITE_PROCTORING_MAX_TAB_SWITCHES=1
VITE_PROCTORING_EYE_DETECTION_ENABLED=true
# Auto-submit after this many face warnings (0 = warn only).
VITE_PROCTORING_MAX_EYE_WARNINGS=0
# How often the face check runs, in ms.
VITE_PROCTORING_EYE_CHECK_INTERVAL_MS=5000

# ── Noise check ──
VITE_PROCTORING_NOISE_ENABLED=true
# dBFS: below WARN is green, WARN to BLOCK is amber, above BLOCK is red.
VITE_PROCTORING_NOISE_WARN_DB=-45
VITE_PROCTORING_NOISE_BLOCK_DB=-32
# How long it must stay loud before turning red, in ms.
VITE_PROCTORING_NOISE_SUSTAIN_MS=1500
# false = red warns but never blocks the start.
VITE_PROCTORING_NOISE_BLOCKS_START=true

# ── Identity photo ──
# true = required and stored; false = step hidden.
VITE_PROCTORING_PHOTO_REQUIRED=true
# Longest edge of the saved image, in px.
VITE_PROCTORING_PHOTO_MAX_WIDTH=640

# ── Room scan ──
# true = required 360° sweep; false = step hidden.
VITE_PROCTORING_ROOM_SCAN_REQUIRED=true
VITE_PROCTORING_ROOM_SCAN_FRAMES=12
# Time given for the full turn, in ms.
VITE_PROCTORING_ROOM_SCAN_DURATION_MS=16000
