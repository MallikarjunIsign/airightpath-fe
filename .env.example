# Copy to `.env.development` (local) or `.env.production` (build).
# Only VITE_ variables reach the browser — never put secrets here.
# Values below are the code defaults; delete a line to keep its default.

VITE_API_BASE_URL=http://localhost:8082
VITE_WS_URL=ws://localhost:8082
VITE_WS_BASE_URL=ws://localhost:8082
# LAN IP for testing on a phone against a local backend.
VITE_LOCAL_IP=192.168.1.8

# ── Coding exam (optional; defaults in src/config/coding-exam.config.ts) ──
# Which test cases show their input and expected output during the exam:
#   locked  = nothing shown until that case passes (default)
#   open    = every case shows input, expected and the candidate's output
#   partial = the first few are open, the rest unlock as they pass ("half" also works)
VITE_CODING_TESTCASE_VISIBILITY=locked
# partial only: fixed number of open cases. 0 = work it out from the ratio below.
VITE_CODING_TESTCASE_OPEN_COUNT=0
# partial only: fraction open from the start, rounded down. 0.5 = half.
VITE_CODING_TESTCASE_OPEN_RATIO=0.5

# ── Exam proctoring (optional; defaults in src/config/proctoring.config.ts) ──
VITE_PROCTORING_CAMERA_REQUIRED=true
VITE_PROCTORING_FULLSCREEN_ENABLED=true
VITE_PROCTORING_TAB_SWITCH_ENABLED=true
# Auto-submit after this many tab switches (0 = warn only).
VITE_PROCTORING_MAX_TAB_SWITCHES=5
VITE_PROCTORING_EYE_DETECTION_ENABLED=true
# Auto-submit after this many face warnings (0 = warn only).
VITE_PROCTORING_MAX_EYE_WARNINGS=5
# How often the face check runs, in ms.
VITE_PROCTORING_EYE_CHECK_INTERVAL_MS=4000

# Looking down is NOT a violation by default: the exam is typed, and a
# candidate looking at their keyboard was collecting a warning every 8
# seconds until five of them auto-submitted the paper. Set true only where
# the paper is read rather than typed.
VITE_PROCTORING_FLAG_LOOKING_DOWN=false
# Consecutive 4s checks a sideways glance must persist before it warns (~12s).
VITE_PROCTORING_LOOK_AWAY_CHECKS=3
# Consecutive 4s checks with no face found before it warns (~24s). The
# detector loses a head tilted over a keyboard, so a short miss means
# "typing" as often as "gone"; the counter resets as soon as a face is seen.
VITE_PROCTORING_NO_FACE_CHECKS=6

# ── Noise check ──
VITE_PROCTORING_NOISE_ENABLED=true
# dBFS: below WARN is green, WARN to BLOCK is amber, above BLOCK is red.
VITE_PROCTORING_NOISE_WARN_DB=-45
VITE_PROCTORING_NOISE_BLOCK_DB=-32
# How long it must stay loud before turning red, in ms.
VITE_PROCTORING_NOISE_SUSTAIN_MS=1500
# false = red warns but never blocks the start.
VITE_PROCTORING_NOISE_BLOCKS_START=true

# ── Identity photo ──
# true = required and stored; false = step hidden.
VITE_PROCTORING_PHOTO_REQUIRED=true
# Longest edge of the saved image, in px.
VITE_PROCTORING_PHOTO_MAX_WIDTH=640

# ── Room scan ──
# true = required 360° sweep; false = step hidden.
VITE_PROCTORING_ROOM_SCAN_REQUIRED=false
VITE_PROCTORING_ROOM_SCAN_FRAMES=8
# Time given for the full turn, in ms.
VITE_PROCTORING_ROOM_SCAN_DURATION_MS=16000
# ── Phone as a second camera (interviews) ──
# true = the candidate must pair their phone before starting;
# false = the QR is offered and they may begin without it.
VITE_PROCTORING_MOBILE_REQUIRED=false
# true = the paired phone also offers its microphone, and the candidate can
# choose it instead of this device's. Never switched automatically: the phone is
# often on a stand across the room for the camera angle, where it is the worse
# microphone. They pick; the device mic stays the default.
VITE_PROCTORING_MOBILE_AUDIO_ENABLED=false
# true = the phone's wide shot is also watched for a second person in the room.
# Face detection otherwise only sees the laptop camera, so someone sitting just
# outside that frame is invisible to every check. Records and warns only —
# never ends the interview, because a room angle catches a lot of innocent
# movement and that judgement belongs to a reviewer.
VITE_PROCTORING_ROOM_WATCH_ENABLED=false
# How often the room angle is checked, in ms. Slower than the face check: a
# person in a room does not appear and vanish between frames.
VITE_PROCTORING_ROOM_WATCH_INTERVAL_MS=8000

# ── Transcription ──
# Audio quieter than this (0-100 scale) is treated as holding no speech and is
# never sent for transcription. Whisper does not return an empty string for a
# fan or a keyboard — it returns fluent invention, which then lands in the
# transcript as something the candidate said. Raise it in noisy rooms, lower it
# if quiet speakers are being dropped.
VITE_TRANSCRIPTION_SILENCE_FLOOR=6

# -- Interview recording --
# Each stream is either asked for or skipped outright; there is no "optional".
# true  = recorded and uploaded with the interview.
# false = skipped entirely, and the candidate is never prompted for it.
# The candidate's camera and microphone. False still leaves the camera free to
# open for face detection (VITE_PROCTORING_EYE_DETECTION_ENABLED) -- it only
# stops the recording being made and uploaded.
VITE_PROCTORING_CAMERA_RECORDING_REQUIRED=true
# How heavy the camera recording is. No bitrate was set before, so the browser
# chose ~2.5 Mbps — over a gigabyte for a 70-minute interview, which exceeded
# the server's own upload limit and never once stored. 500 kbps is ample for
# evidence of who sat the interview and puts 70 minutes at roughly 280MB.
VITE_PROCTORING_CAMERA_VIDEO_BITRATE=700000
VITE_PROCTORING_CAMERA_AUDIO_BITRATE=48000
# What the camera is asked to capture. Left to the browser it picks up to
# 720p30, and capping the bitrate alone then just makes that look worse rather
# than cost less. 640x360 at 15fps is a video call: unambiguous evidence of who
# sat the interview, which is the whole job. ~175MB for 70 minutes.
VITE_PROCTORING_CAMERA_WIDTH=640
VITE_PROCTORING_CAMERA_HEIGHT=360
VITE_PROCTORING_CAMERA_FRAMERATE=15
# The candidate's screen, via the browser's display-capture prompt.
VITE_PROCTORING_SCREEN_RECORDING_REQUIRED=true
